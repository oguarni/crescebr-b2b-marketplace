# DB_HOST: use "localhost" for local dev (hybrid workflow), "db" for full Docker deployment
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_NAME=crescebr
DB_PORT=5432

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Public sign-up (/auth/register, /auth/register-supplier) is refused when
# NODE_ENV=production unless this is "true". Development and test leave it open.
# PUBLIC_REGISTRATION=false
